# Producción (VPS)
DOMAIN=manuscritos.live
LETSENCRYPT_EMAIL=tu@email

# Anti-bot (opcional)
FACE_ANTIBOT_ENABLED=0
FACE_ANTIBOT_TEST_MODE=0
FACE_ANTIBOT_SECRET=change-this-in-production
FACE_ANTIBOT_CHALLENGE_TTL_MS=120000

# Admin (estadísticas)
# Protege /admin/stats. Usa un secreto largo (no lo compartas).
ADMIN_STATS_TOKEN=

# (Opcional) secreto para anonimizar IPs en métricas (si vacío, usa FACE_ANTIBOT_SECRET)
METRICS_IP_SECRET=

# OpenClaw webhook (para alertas por email via SMTP)
OPENCLAW_WEBHOOK_SECRET=

# SMTP (alertas)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=

# PayPal (sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=EUR
PAYPAL_UNLOCK_AMOUNT=1.00
