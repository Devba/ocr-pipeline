# Producción (VPS)
DOMAIN=manuscritos.live
LETSENCRYPT_EMAIL=tu@email

# Anti-bot (opcional)
FACE_ANTIBOT_ENABLED=0
FACE_ANTIBOT_TEST_MODE=0
FACE_ANTIBOT_SECRET=change-this-in-production
FACE_ANTIBOT_CHALLENGE_TTL_MS=120000

# Admin (estadísticas)
# Protege /admin/stats. Usa un secreto largo (no lo compartas).
ADMIN_STATS_TOKEN=

# Auth (login email / MetaMask)
# Secreto para firmar/hash de tokens (sesiones, magic links). Pon uno largo.
AUTH_TOKEN_SECRET=

# (Opcional) secreto para anonimizar IPs en métricas (si vacío, usa FACE_ANTIBOT_SECRET)
METRICS_IP_SECRET=

# OpenClaw webhook (para alertas por email via SMTP)
OPENCLAW_WEBHOOK_SECRET=

# SMTP (alertas)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=

# PayPal (sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=EUR
PAYPAL_UNLOCK_AMOUNT=1.00

# Cooldown entre OCR por IP (milisegundos). Útil para pruebas.
OCR_COOLDOWN_MS=15000

# Botón extra para pruebas: desbloquea el texto completo sin PayPal.
# NO lo actives en producción.
SIMULATE_PAYMENT_ENABLED=0

# Google Document AI (OCR) - opcional
# Nota: en Docker necesitarás credenciales (por ejemplo GOOGLE_APPLICATION_CREDENTIALS apuntando a un JSON montado en el contenedor).
DOC_AI_ENABLED=0
DOC_AI_PROJECT_ID=
DOC_AI_LOCATION=us
DOC_AI_PROCESSOR_ID=
DOC_AI_PROCESSOR_VERSION_ID=
DOC_AI_SUMMARY_CHARS=1200
# Pistas de idioma para Document AI (prioriza modelos). Ej: es,la
DOC_AI_LANGUAGE_HINTS=es,la
# Log de depuración (no imprime el texto OCR, solo métricas: bytes/páginas/ms)
DOC_AI_DEBUG_LOG=0
GOOGLE_APPLICATION_CREDENTIALS=

# Post-procesado opcional (corrige OCR con un LLM). Requiere permisos en Vertex AI.
POSTPROCESS_ENABLED=0
POSTPROCESS_PROVIDER=vertex
POSTPROCESS_LANGUAGE_HINTS=es,la
POSTPROCESS_MAX_CHARS=20000
POSTPROCESS_TIMEOUT_MS=20000

# Vertex AI (Gemini)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-1.5-flash
